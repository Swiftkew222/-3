import math
from typing import List, Union
def add(a: Union[int, float], b: Union[int, float]) -> Union[int, float]:
    if not (isinstance(a, (int, float)) and isinstance(b, (int, float))):
        raise TypeError("Операнды должны быть числами")
    return a + b
def subtract(a: Union[int, float], b: Union[int, float]) -> Union[int, float]:
    if not (isinstance(a, (int, float)) and isinstance(b, (int, float))):
        raise TypeError("Операнды должны быть числами")
    return a - b
def multiply(a: Union[int, float], b: Union[int, float]) -> Union[int, float]:
    if not (isinstance(a, (int, float)) and isinstance(b, (int, float))):
        raise TypeError("Операнды должны быть числами")
    return a * b
def divide(a: Union[int, float], b: Union[int, float], mode='/') -> Union[int, float]:
    if not (isinstance(a, (int, float)) and isinstance(b, (int, float))):
        raise TypeError("Операнды должны быть числами")
    if b == 0:
        raise ZeroDivisionError("Деление на ноль недопустимо")
    if mode == '/':
        return a / b
    elif mode == '%':
        return a % b
    elif mode == '//':
        return a // b
    else:
        raise ValueError("Недопустимый режим деления")
def power(a: Union[int, float], b: Union[int, float]) -> Union[int, float]:
    if not (isinstance(a, (int, float)) and isinstance(b, (int, float))):
        raise TypeError("Операнды должны быть числами")
    return a ** b
def factorial(n: int) -> int:
    if not isinstance(n, int):
        raise TypeError("Факториал можно вычислять только для целых чисел")
    if n < 0:
        raise ValueError("Факториал не определён для отрицательных чисел")
    return math.factorial(n)
def sine(x: Union[int, float]) -> float:
    if not isinstance(x, (int, float)):
        raise TypeError("Аргумент должен быть числом")
    return math.sin(x)
def median(numbers: List[Union[int, float]]) -> float:
    if not all(isinstance(num, (int, float)) for num in numbers):
        raise TypeError("Все элементы должны быть числами")
    sorted_list = sorted(numbers)
    n = len(sorted_list)
    middle = n // 2
    if n % 2 == 0:
        return (sorted_list[middle - 1] + sorted_list[middle]) / 2
    else:
        return float(sorted_list[middle])
print("Доступные операции:")
print("Сложение(1)")
print("Вычитание(2)")
print("Умножение(3)")
print("Деление(4)")
print("Возведение в степень(5)")
print("Факториал(6)")
print("Синус(7)")
print("Медиана(8)")
print("Напишите 'exit' для выхода")
while True:
    command = input("Операция: ").strip()
    if command.lower() == 'exit':
        break
    if command not in [str(i) for i in range(1, 9)]:
        print("Не правильная команда ")
        continue
    try:
        if command == '1':
            a = float(input("Слагаемое 1: "))
            b = float(input("Слагаемое 2: "))
            result = add(a, b)
            print(f">>> {result}")
        elif command == '2':  
            a = float(input("Разность 1: "))
            b = float(input("Разность 2: "))
            result = subtract(a, b)
            print(f">>> {result}")
        elif command == '3':  
            a = float(input("Множитель 1: "))
            b = float(input("Множитель 2: "))
            result = multiply(a, b)
            print(f">>> {result}")
        elif command == '4': 
            a = float(input("Дробимое: "))
            b = float(input("Делитель: "))
            print("Выберите режим деления: '/' - деление, '%' - остаток, '//' - целочисленное")
            mode = input("Режим: ").strip()
            result = divide(a, b, mode)
            print(f">>> {result}")
        elif command == '5': 
            a = float(input("Число: "))
            b = float(input("Степень: "))
            result = power(a, b)
            print(f">>> {result}")
        elif command == '6': 
            n = int(input("Целое число: "))
            result = factorial(n)
            print(f">>> {result}")
        elif command == '7': 
            x = float(input("Введите число (радианы): "))
            result = sine(x)
            print(f">>> {result}")
        elif command == '8': 
            s = input("Введите список чисел через пробел: ")
            numbers = [float(x) for x in s.split()]
            result = median(numbers)
            print(f">>> {result}")
    except Exception as e:
        print(f"Ошибка: {e}")
print("Выход из программы")
